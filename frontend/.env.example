# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.

# API origin. Leave empty for local dev: Vite proxies /api to http://localhost:8080.
# Production: https://reviewer-api-842778673613.asia-south1.run.app
VITE_API_URL=

# Firebase console → Project settings → General → Your apps → Web app config.
# These identify the Firebase project; they are not secrets, but keep .env out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=qwiklabs-gcp-02-1805d7f7e612.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qwiklabs-gcp-02-1805d7f7e612
VITE_FIREBASE_APP_ID=
